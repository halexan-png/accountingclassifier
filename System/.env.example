# Copy this file to .env and fill in real values. .env is gitignored.

# Required for any PAID command (probe-limits, deal-profile, run without
# --dry-run). Free/local commands (ingest-check, recover, run --dry-run)
# do not need it.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional. Overrides run_gna.ps1/gna_pipeline's TTY auto-detection for the
# live status/progress line (console.py). Leave unset unless the console
# output looks wrong in your terminal. Any of 0/false/False/"" = force
# non-TTY (plain line-by-line prints); anything else = force TTY.
# GNA_FORCE_TTY=1

# Optional. Port the local web UI server (gna_server/, Wave 2+, `pip install
# -e .[ui]`) binds on loopback (127.0.0.1). Leave unset for its default port.
# GNA_UI_PORT=8420

# Optional. Microsoft Graph delegated auth for OneDrive/SharePoint invoice
# links (gna_pipeline/graph_auth.py). Entirely additive: with these unset,
# invoice_read falls back to its plain anonymous fetch (invoice_unavailable
# on a OneDrive/SharePoint link, same as any other unreachable URL) -- no
# command requires this. Get these from IT's app registration (a "public
# client" -- no client secret exists to leak).
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
